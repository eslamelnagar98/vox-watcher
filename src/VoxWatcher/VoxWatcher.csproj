<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Package audit advisories should be visible, not break the scheduled build. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <RootNamespace>VoxWatcher</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Real browser fetcher (VOX_FETCHER=browser|auto). Keep in sync with the Playwright cache key in the workflow. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.65.1" />
  </ItemGroup>

</Project>
